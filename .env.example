# ------------------------------------------------------------------
# CosmoTrekk environment variables (ALL OPTIONAL — the game works with none)
# Copy this file to ".env.local" for local "vercel dev", or paste the
# values into Vercel → Project → Settings → Environment Variables.
# Every service below has a FREE tier. Never commit real values.
# ------------------------------------------------------------------

# --- Gemini (free key from https://aistudio.google.com/apikey) — SERVER ONLY ---
GEMINI_API_KEY=
# Model name, e.g. a current "flash" model listed in Google AI Studio
GEMINI_MODEL=

# --- NASA (free key from https://api.nasa.gov ; "DEMO_KEY" works for light use) — SERVER ONLY ---
NASA_API_KEY=

# --- Protects the "refresh question bank" endpoint — SERVER ONLY, any long random text ---
ADMIN_REFRESH_TOKEN=

# --- Supabase (free project at https://supabase.com) for OPTIONAL connected rankings ---
# Public values (safe in the browser; protected by row-level security):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Secret value (server only — NEVER prefix with VITE_):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
